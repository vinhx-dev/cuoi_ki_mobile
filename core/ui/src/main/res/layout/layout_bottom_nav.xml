<?xml version="1.0" encoding="utf-8"?>
<!-- ===== LAYOUT DÙNG CHUNG CHỨA BOTTOM NAVIGATION BAR ===== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Phần nội dung phía trên: Để trống cho các trang tự đổ nội dung vào -->
    <FrameLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Đường kẻ mảnh 1dp phía trên thanh bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB" />

    <!-- Bottom Navigation Bar nền trắng, 3 tab: Trang chủ, Trạng thái, Tôi -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_bottom_bar_menu"
        app:paddingBottomSystemWindowInsets="false" />

</LinearLayout>
