<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#FFFFFF">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="32dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="160dp" android:orientation="vertical" android:padding="24dp" android:background="#EB6A1B">
   <Button android:id="@+id/btnOtpBack" android:layout_width="wrap_content" android:layout_height="48dp" android:text="← Quay lại" android:textColor="#FFFFFF" android:backgroundTint="#EB6A1B" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xác thực tài khoản" android:textSize="26sp" android:textStyle="bold" android:textColor="#FFFFFF" android:paddingTop="16dp" />
  </LinearLayout>
  <TextView android:id="@+id/textOtpEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:textSize="16sp" android:textColor="#333333" />
  <EditText android:id="@+id/inputOtp" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginHorizontal="32dp" android:background="@drawable/bg_input" android:inputType="number" android:digits="0123456789" android:maxLength="6" android:hint="000000" android:gravity="center" android:textSize="28sp" android:letterSpacing="0.3" android:autofillHints="smsOTPCode" />
  <Button android:id="@+id/btnVerifyOtp" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginHorizontal="32dp" android:layout_marginTop="24dp" android:text="Xác nhận" android:textColor="#FFFFFF" android:backgroundTint="#EB6A1B" />
  <Button android:id="@+id/btnResendOtp" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginHorizontal="32dp" android:layout_marginTop="12dp" android:text="Gửi lại mã OTP" android:textColor="#EB6A1B" android:backgroundTint="#FFF1E8" />
 </LinearLayout>
</ScrollView>
