<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình đăng nhập tông cam hiện đại -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- KHỐI 1: HEADER (Guideline 37% chiều cao màn hình) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.37" />

        <!-- Nền gradient cam cho header -->
        <View
            android:id="@+id/viewHeaderBg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_header_gradient"
            app:layout_constraintBottom_toTopOf="@+id/guidelineHeader"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Phần đáy header với mũi nhọn chúc xuống -->
        <ImageView
            android:id="@+id/imgHeaderTip"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/header_bottom_tip"
            app:layout_constraintBottom_toBottomOf="@id/viewHeaderBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- KHỐI 2: LOGO (Căn chính giữa background cam, bo góc 20dp) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/cardLogo"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:contentDescription="@string/logo_desc"
            android:elevation="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"
            app:layout_constraintBottom_toBottomOf="@+id/viewHeaderBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/viewHeaderBg"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.LogoCorner20" />

        <!-- KHỐI 3: FORM (Lề trái/phải 40dp) -->

        <!-- a) Ô nhập TÀI KHOẢN -->
        <LinearLayout
            android:id="@+id/layoutAccount"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_height"
            android:layout_marginStart="@dimen/form_margin_horizontal"
            android:layout_marginEnd="@dimen/form_margin_horizontal"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guidelineHeader">

            <!-- Icon hình người -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_user" />

            <!-- EditText tài khoản -->
            <EditText
                android:id="@+id/inputAccount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:autofillHints="username"
                android:background="@null"
                android:hint="@string/hint_account"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/hint_gray"
                android:textSize="@dimen/text_size_input" />
        </LinearLayout>

        <!-- b) Ô nhập MẬT KHẨU (Cách ô tài khoản 14dp) -->
        <LinearLayout
            android:id="@+id/layoutPassword"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_height"
            android:layout_marginStart="@dimen/form_margin_horizontal"
            android:layout_marginEnd="@dimen/form_margin_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutAccount">

            <!-- Icon ổ khóa -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock" />

            <!-- EditText mật khẩu -->
            <EditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:autofillHints="password"
                android:background="@null"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/hint_gray"
                android:textSize="@dimen/text_size_input" />
        </LinearLayout>

        <!-- c) NÚT ĐĂNG NHẬP (Cách ô mật khẩu 28dp, bo tròn viên thuốc, gradient ngang, elevation 8dp) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/form_margin_horizontal"
            android:layout_marginEnd="@dimen/form_margin_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_login"
            android:elevation="8dp"
            android:letterSpacing="0.2"
            android:text="@string/btn_login"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutPassword" />

        <!-- d) HÀNG LINK (Cách nút đăng nhập 16dp, trái: Đăng ký tài khoản, phải: Quên mật khẩu?) -->
        <TextView
            android:id="@+id/textRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_margin_horizontal"
            android:layout_marginTop="16dp"
            android:padding="4dp"
            android:text="@string/link_register"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_link"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnLogin" />

        <TextView
            android:id="@+id/textForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/form_margin_horizontal"
            android:layout_marginTop="16dp"
            android:padding="4dp"
            android:text="@string/link_forgot"
            android:textColor="@color/text_dark"
            android:textSize="@dimen/text_size_link"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnLogin" />

        <!-- e) PHẦN "ĐĂNG NHẬP BẰNG CÁCH KHÁC" -->
        <TextView
            android:id="@+id/textOtherLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="@string/other_login"
            android:textColor="@color/text_gray"
            android:textSize="@dimen/text_size_other"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textRegister" />

        <!-- Đường kẻ ngang mảnh -->
        <View
            android:id="@+id/viewLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/form_margin_horizontal"
            android:layout_marginEnd="@dimen/form_margin_horizontal"
            android:layout_marginTop="12dp"
            android:background="@color/line_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textOtherLogin" />

        <!-- Hàng 3 icon tròn mạng xã hội -->
        <LinearLayout
            android:id="@+id/layoutSocialIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewLine">

            <!-- Icon 1: Viền green -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/bg_social_green">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_social_b" />
            </FrameLayout>

            <!-- Icon 2: Viền blue -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/bg_social_blue">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_social_b" />
            </FrameLayout>

            <!-- Icon 3: Viền red -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="12dp"
                android:background="@drawable/bg_social_red">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_social_b" />
            </FrameLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
