<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- HEADER cam cố định ở trên, cao 200dp -->
        <View
            android:id="@+id/viewHeaderReg"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_header_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Logo hình vuông bo góc 20dp (Căn chính giữa background cam) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/cardLogoReg"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/logo_desc"
            android:elevation="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo"
            app:layout_constraintBottom_toBottomOf="@+id/viewHeaderReg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/viewHeaderReg"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.LogoCorner20" />

        <!-- Mũi nhọn chúc xuống ở đáy header (header_bottom_tip) -->
        <ImageView
            android:id="@+id/imgHeaderTipReg"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/header_bottom_tip"
            app:layout_constraintBottom_toBottomOf="@+id/viewHeaderReg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- BƯỚC 1: groupForm (Nhập thông tin đăng ký) -->
        <LinearLayout
            android:id="@+id/groupForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_margin_horizontal"
            android:layout_marginEnd="@dimen/form_margin_horizontal"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewHeaderReg">

            <!-- Tiêu đề Tạo tài khoản -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:text="@string/reg_title"
                android:textColor="#333333"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 1. Tên đăng nhập -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_user" />

                <EditText
                    android:id="@+id/inputUsername"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:autofillHints="username"
                    android:background="@null"
                    android:hint="@string/hint_username"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/hint_gray"
                    android:textSize="@dimen/text_size_input" />
            </LinearLayout>

            <!-- 2. Email / Số điện thoại -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_email" />

                <EditText
                    android:id="@+id/inputEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:autofillHints="emailAddress"
                    android:background="@null"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/hint_gray"
                    android:textSize="@dimen/text_size_input" />
            </LinearLayout>

            <EditText
                android:id="@+id/inputPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_input"
                android:hint="Số điện thoại (không bắt buộc)"
                android:inputType="phone"
                android:autofillHints="phone"
                android:maxLines="1" />
            <!-- 3. Mật khẩu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/inputPasswordReg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="@null"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/hint_gray"
                    android:textSize="@dimen/text_size_input" />

                <ImageView
                    android:id="@+id/btnTogglePass1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_eye_off" />
            </LinearLayout>

            <!-- 4. Nhập lại mật khẩu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/inputRePassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="@null"
                    android:hint="@string/hint_repassword"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/hint_gray"
                    android:textSize="@dimen/text_size_input" />

                <ImageView
                    android:id="@+id/btnTogglePass2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_eye_off" />
            </LinearLayout>

            <!-- 5. CheckBox điều khoản -->
            <CheckBox
                android:id="@+id/checkboxTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/terms_agreement"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 6. TextView báo lỗi (tvError) ẩn mặc định -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- 7. Nút Đăng ký -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegisterSubmit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_button_login"
                android:elevation="8dp"
                android:text="@string/btn_register"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 8. Dòng chuyển về đăng nhập -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/already_have_account"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textGoLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="2dp"
                    android:text="@string/login_action"
                    android:textColor="#F0701E"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- BƯỚC 2: groupOtp (Nhập mã xác nhận OTP qua email) -->
        <LinearLayout
            android:id="@+id/groupOtp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_margin_horizontal"
            android:layout_marginEnd="@dimen/form_margin_horizontal"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/viewHeaderReg">

            <!-- Tiêu đề Xác nhận email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:text="@string/otp_title"
                android:textColor="#333333"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- TextView mô tả (tvOtpInfo) -->
            <TextView
                android:id="@+id/tvOtpInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- EditText nhập mã (etOtp) -->
            <EditText
                android:id="@+id/etOtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:autofillHints="postalCode"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:hint="@string/hint_otp"
                android:inputType="number"
                android:letterSpacing="0.5"
                android:maxLength="6"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/hint_gray"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- TextView lỗi OTP (tvOtpError) -->
            <TextView
                android:id="@+id/tvOtpError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Nút Xác nhận -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConfirmOtp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_button_login"
                android:elevation="8dp"
                android:text="@string/btn_confirm"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- TextView Gửi lại mã (tvResendOtp) -->
            <TextView
                android:id="@+id/tvResendOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:padding="4dp"
                android:text="@string/resend_code"
                android:textColor="#F0701E"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- TextView Đổi email (tvChangeEmail) -->
            <TextView
                android:id="@+id/tvChangeEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:padding="4dp"
                android:text="@string/change_email"
                android:textColor="#F0701E"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
