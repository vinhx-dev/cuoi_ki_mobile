<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShopAdmin" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorOnPrimary">@color/admin_background</item>
        <item name="colorSurface">@color/admin_background</item>
        <item name="colorOnSurface">@color/admin_text</item>
        <item name="colorOnSurfaceVariant">@color/admin_text_secondary</item>
        <item name="colorSecondaryContainer">@color/admin_primary_light</item>
        <item name="colorOnSecondaryContainer">@color/admin_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/admin_background_secondary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ShopAdmin.Dialog</item>
    </style>
    <style name="ThemeOverlay.ShopAdmin" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorOnPrimary">@color/admin_background</item>
        <item name="colorSecondary">@color/admin_primary</item>
        <item name="colorSecondaryContainer">@color/admin_primary_light</item>
        <item name="colorOnSecondaryContainer">@color/admin_primary</item>
        <item name="colorSurface">@color/admin_background</item>
        <item name="colorOnSurface">@color/admin_text</item>
        <item name="colorOnSurfaceVariant">@color/admin_text_secondary</item>
        <item name="colorOutline">@color/admin_border</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColorPrimary">@color/admin_text</item>
        <item name="android:textColorSecondary">@color/admin_text_secondary</item>
        <item name="chipStyle">@style/Admin.Chip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ShopAdmin.Dialog</item>
    </style>
    <style name="ThemeOverlay.ShopAdmin.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorSurface">@color/admin_background</item>
        <item name="colorOnSurface">@color/admin_text</item>
    </style>
    <style name="Admin.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/admin_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/admin_background</item>
    </style>
    <style name="Admin.Card.Hero" parent="Admin.Card">
        <item name="cardCornerRadius">24dp</item>
        <item name="strokeColor">@color/admin_hero</item>
        <item name="cardBackgroundColor">@color/admin_hero</item>
    </style>
    <style name="Admin.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/admin_primary</item>
        <item name="android:textColor">@color/admin_background</item>
        <item name="iconTint">@color/admin_background</item>
    </style>
    <style name="Admin.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/admin_border</item>
        <item name="backgroundTint">@color/admin_background</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="iconTint">@color/admin_text</item>
    </style>
    <style name="Admin.Button.Danger" parent="Admin.Button.Outlined">
        <item name="android:textColor">@color/admin_danger</item>
        <item name="iconTint">@color/admin_danger</item>
        <item name="strokeColor">@color/admin_danger_light</item>
        <item name="backgroundTint">@color/admin_danger_light</item>
    </style>
    <style name="Admin.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item><item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item><item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/admin_input_stroke</item>
        <item name="boxBackgroundColor">@color/admin_background</item>
        <item name="hintTextColor">@color/admin_text_secondary</item>
    </style>
    <style name="Admin.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item><item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item><item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/admin_input_stroke</item>
        <item name="boxBackgroundColor">@color/admin_background</item>
        <item name="hintTextColor">@color/admin_text_secondary</item>
    </style>
    <style name="Admin.Heading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/admin_text</item><item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Admin.PageTitle" parent="Admin.Heading"><item name="android:textSize">28sp</item><item name="android:letterSpacing">-0.035</item></style>
    <style name="Admin.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/admin_text_secondary</item><item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Admin.Kicker" parent="Admin.Body">
        <item name="android:textSize">10sp</item><item name="android:letterSpacing">0.12</item><item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Admin.NavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item><item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Admin.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/admin_primary_light</item>
        <item name="android:width">54dp</item><item name="android:height">30dp</item>
    </style>
    <style name="Admin.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/admin_chip_background</item><item name="chipStrokeColor">@color/admin_border</item>
        <item name="chipStrokeWidth">1dp</item><item name="checkedIconTint">@color/admin_primary</item>
        <item name="android:textColor">@color/admin_text</item>
    </style>
    <style name="ThemeOverlay.ShopAdmin.Calendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/admin_primary</item><item name="colorOnPrimary">@color/admin_background</item>
        <item name="colorSurface">@color/admin_background</item><item name="colorOnSurface">@color/admin_text</item>
    </style>
</resources>
