<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/admin_background_secondary">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="12dp" android:paddingBottom="24dp">
            <TextView android:id="@+id/textOrderCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.PageTitle"/>
            <Space android:layout_width="1dp" android:layout_height="8dp"/>
            <TextView android:id="@+id/textOrderDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Body"/>
            <Space android:layout_width="1dp" android:layout_height="14dp"/>
            <TextView android:id="@+id/textOrderStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Heading" android:text="@string/admin_order_customer" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"/>
            <com.google.android.material.card.MaterialCardView style="@style/Admin.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/admin_ic_account" app:tint="@color/admin_primary" android:contentDescription="@null"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="@string/admin_recipient" android:textAppearance="@style/Admin.Heading" android:textSize="15sp"/>
                    </LinearLayout>
                    <Space android:layout_width="1dp" android:layout_height="16dp"/>
                    <TextView android:id="@+id/textCustomerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Heading" android:textSize="15sp" android:lineSpacingExtra="5dp"/>
                    <Space android:layout_width="1dp" android:layout_height="12dp"/>
                    <TextView android:id="@+id/textCustomerPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Body"/>
                    <Space android:layout_width="1dp" android:layout_height="8dp"/>
                    <TextView android:id="@+id/textCustomerAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Body" android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Heading" android:text="@string/admin_order_items" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"/>
            <com.google.android.material.card.MaterialCardView style="@style/Admin.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/orderItems"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/admin_border" android:layout_marginVertical="16dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Body" android:text="@string/admin_order_total"/>
                    <Space android:layout_width="1dp" android:layout_height="9dp"/>
                    <TextView android:id="@+id/textOrderTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Heading" android:textSize="28sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/admin_background">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/admin_border"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingVertical="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelOrder" style="@style/Admin.Button.Danger" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/admin_order_cancel"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAdvanceOrder" style="@style/Admin.Button" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/admin_order_ship"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
