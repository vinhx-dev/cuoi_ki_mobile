<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_background_secondary"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/admin_text"
            android:textSize="20sp"
            android:text="@string/admin_shop_info"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputShopNameLayout"
            style="@style/Admin.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="@string/admin_shop_name">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputShopName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textSize="15sp"
                android:maxLength="80" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputShopEmailLayout"
            style="@style/Admin.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:hint="@string/admin_shop_email">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputShopEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/admin_notification_setting"
            android:textColor="@color/admin_text" />
        <com.google.android.material.button.MaterialButton
            style="@style/Admin.Button"
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_save_settings"
            android:layout_marginTop="20dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/admin_text"
            android:textSize="12sp"
            android:text="@string/admin_demo_info"
            android:layout_marginTop="32dp"
            android:gravity="center" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
