<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/admin_background_secondary" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="12dp" android:paddingBottom="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.PageTitle" android:text="@string/admin_preferences_heading"/>
        <Space android:layout_width="1dp" android:layout_height="10dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Body" android:text="@string/admin_local_settings_note"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Heading" android:text="@string/admin_contact_preferences" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"/>
        <com.google.android.material.card.MaterialCardView style="@style/Admin.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputShopNameLayout" style="@style/Admin.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/admin_display_name">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputShopName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textSize="14sp" android:textColor="@color/admin_text"/>
                </com.google.android.material.textfield.TextInputLayout>
                <Space android:layout_width="1dp" android:layout_height="16dp"/>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputShopEmailLayout" style="@style/Admin.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/admin_contact_email">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputShopEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:textSize="14sp" android:textColor="@color/admin_text"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Heading" android:text="@string/admin_preferences_notifications" android:layout_marginTop="24dp" android:layout_marginBottom="12dp"/>
        <com.google.android.material.card.MaterialCardView style="@style/Admin.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Heading" android:text="@string/admin_notifications" android:textSize="15sp"/>
                    <Space android:layout_width="1dp" android:layout_height="6dp"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Body" android:text="@string/admin_local_notifications_hint"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchNotifications" android:layout_width="wrap_content" android:layout_height="48dp" android:contentDescription="@string/admin_notifications"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <Space android:layout_width="1dp" android:layout_height="24dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveSettings" style="@style/Admin.Button" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/admin_save_settings"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
