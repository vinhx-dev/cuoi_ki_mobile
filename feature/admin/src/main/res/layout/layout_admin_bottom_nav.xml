<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.bottomnavigation.BottomNavigationView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="68dp"
    android:background="@color/admin_background"
    android:backgroundTint="@color/admin_background"
    android:elevation="0dp"
    android:theme="@style/ThemeOverlay.ShopAdmin"
    app:menu="@menu/admin_bottom_nav"
    app:itemIconTint="@color/admin_nav_tint"
    app:itemTextColor="@color/admin_nav_tint"
    app:itemIconSize="24dp"
    app:itemTextAppearanceActive="@style/Admin.NavText"
    app:itemTextAppearanceInactive="@style/Admin.NavText"
    app:itemHorizontalTranslationEnabled="false"
    app:labelVisibilityMode="labeled"
    app:paddingBottomSystemWindowInsets="false" />
