<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/admin_background_secondary">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="12dp" android:paddingBottom="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.PageTitle" android:text="@string/admin_title_products"/>
                <Space android:layout_width="1dp" android:layout_height="6dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Body" android:text="@string/admin_catalog_hint"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAddProduct" style="@style/Admin.Button" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/admin_add_short" app:icon="@drawable/admin_ic_add" android:layout_marginStart="12dp"/>
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="20dp"/>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputSearchLayout" style="@style/Admin.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/admin_search_products" app:startIconDrawable="@drawable/admin_ic_search">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textSize="14sp" android:textColor="@color/admin_text" android:maxLines="1" android:imeOptions="actionSearch"/>
        </com.google.android.material.textfield.TextInputLayout>
        <Space android:layout_width="1dp" android:layout_height="12dp"/>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputFilterLayout" style="@style/Admin.Dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/admin_filter_category">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/inputFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/textResultCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Kicker" android:layout_marginTop="14dp"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/adminList" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingHorizontal="20dp" android:paddingBottom="20dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/emptyState" android:layout_gravity="center" android:paddingHorizontal="28dp" android:visibility="gone">
            <ImageView android:layout_width="78dp" android:layout_height="78dp" android:src="@drawable/admin_ic_box" app:tint="@color/admin_primary" android:contentDescription="@null" android:layout_gravity="center_horizontal" android:background="@drawable/admin_avatar_background" android:padding="18dp" android:minWidth="78dp" android:minHeight="78dp"/>
            <Space android:layout_width="1dp" android:layout_height="20dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Heading" android:text="@string/admin_products_empty" android:gravity="center" android:textSize="18sp"/>
            <Space android:layout_width="1dp" android:layout_height="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textAppearance="@style/Admin.Body" android:text="@string/admin_products_empty_hint" android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
