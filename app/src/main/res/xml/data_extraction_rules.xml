<?xml version="1.0" encoding="utf-8"?>
<!-- Sao lưu lên cloud và chuyển sang máy mới (Android 12+).
     Không mang theo file lưu phiên đăng nhập (token) của LocalStorage. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ecom_app_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ecom_app_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
