<?xml version="1.0" encoding="utf-8"?>
<!-- ===== KHAI BÁO TẤT CẢ CÁC TRANG =====
     - android:id     = id khai báo trong core/navigation/src/main/res/values/ids.xml
     - android:name   = class Fragment trong module feature/* tương ứng
     - android:label  = tiêu đề hiển thị trên header
     - Layout khung (header/back/bottom nav): RouteConfig.java ở :core:navigation
     - Điều hướng: gọi qua AppRouter.java ở :core:navigation -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- BLANK -->
    <fragment
        android:id="@id/splashFragment"
        android:name="com.example.ecom.feature.splash.SplashFragment"
        android:label="@string/app_name" />

    <!-- AUTH -->
    <fragment
        android:id="@id/loginFragment"
        android:name="com.example.ecom.feature.auth.LoginFragment"
        android:label="@string/title_login" />

    <fragment
        android:id="@id/registerFragment"
        android:name="com.example.ecom.feature.auth.RegisterFragment"
        android:label="@string/title_register" />

    <!-- MAIN (có bottom nav) -->
    <fragment
        android:id="@id/homeFragment"
        android:name="com.example.ecom.feature.home.HomeFragment"
        android:label="@string/tab_home" />

    <fragment
        android:id="@id/ordersFragment"
        android:name="com.example.ecom.feature.order.OrdersFragment"
        android:label="@string/tab_orders" />

    <fragment
        android:id="@id/profileFragment"
        android:name="com.example.ecom.feature.profile.ProfileFragment"
        android:label="@string/tab_profile" />

    <!-- DETAIL (có nút back) -->
    <fragment
        android:id="@id/productDetailFragment"
        android:name="com.example.ecom.feature.product.ProductDetailFragment"
        android:label="@string/title_product_detail">
        <argument
            android:name="productId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@id/orderDetailFragment"
        android:name="com.example.ecom.feature.order.OrderDetailFragment"
        android:label="@string/title_order_detail">
        <argument
            android:name="orderId"
            app:argType="integer" />
    </fragment>

    <!-- ADMIN: shared orange shell with five tabs; details hide bottom navigation. -->
    <fragment
        android:id="@id/adminDashboardFragment"
        android:name="com.example.ecom.feature.admin.fragments.AdminDashboardFragment"
        android:label="@string/admin_title_dashboard" />

    <fragment
        android:id="@id/adminProductsFragment"
        android:name="com.example.ecom.feature.admin.fragments.AdminProductsFragment"
        android:label="@string/admin_title_products" />

    <fragment
        android:id="@id/adminOrdersFragment"
        android:name="com.example.ecom.feature.admin.fragments.AdminOrdersFragment"
        android:label="@string/admin_title_orders" />

    <fragment
        android:id="@id/adminUsersFragment"
        android:name="com.example.ecom.feature.admin.fragments.AdminUsersFragment"
        android:label="@string/admin_title_users" />

    <fragment android:id="@id/adminRevenueFragment" android:name="com.example.ecom.feature.admin.fragments.AdminRevenueFragment" android:label="@string/admin_title_revenue" />

    <fragment android:id="@id/adminSettingsFragment" android:name="com.example.ecom.feature.admin.fragments.AdminSettingsFragment" android:label="@string/admin_title_settings" />

    <fragment android:id="@id/adminProductDetailFragment" android:name="com.example.ecom.feature.admin.fragments.AdminProductDetailFragment" android:label="@string/admin_title_product_detail">
        <argument android:name="adminProductId" app:argType="integer" />
    </fragment>

    <fragment android:id="@id/adminProductFormFragment" android:name="com.example.ecom.feature.admin.fragments.AdminProductFormFragment" android:label="@string/admin_title_product_add">
        <argument android:name="adminProductId" app:argType="integer" android:defaultValue="0" />
    </fragment>

    <fragment android:id="@id/adminOrderDetailFragment" android:name="com.example.ecom.feature.admin.fragments.AdminOrderDetailFragment" android:label="@string/admin_title_order_detail">
        <argument android:name="adminOrderId" app:argType="integer" />
    </fragment>

    <fragment android:id="@id/adminUserDetailFragment" android:name="com.example.ecom.feature.admin.fragments.AdminUserDetailFragment" android:label="@string/admin_title_user_detail">
        <argument android:name="adminUserId" app:argType="integer" />
    </fragment>

</navigation>
