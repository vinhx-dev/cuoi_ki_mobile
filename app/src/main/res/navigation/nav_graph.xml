<?xml version="1.0" encoding="utf-8"?>
<!-- ===== KHAI BÁO TẤT CẢ CÁC TRANG =====
     - android:id     = id khai báo trong core/navigation/src/main/res/values/ids.xml
     - android:name   = class Fragment trong module feature/* tương ứng
     - android:label  = tiêu đề hiển thị trên header
     - Layout khung (header/back/bottom nav): RouteConfig.java ở :core:navigation
     - Điều hướng: gọi qua AppRouter.java ở :core:navigation -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <!-- BLANK -->
    <fragment
        android:id="@id/splashFragment"
        android:name="com.example.ecom.feature.splash.SplashFragment"
        android:label="@string/app_name" />

    <!-- AUTH -->
    <fragment
        android:id="@id/loginFragment"
        android:name="com.example.ecom.feature.auth.LoginFragment"
        android:label="@string/title_login" />

    <fragment
        android:id="@id/registerFragment"
        android:name="com.example.ecom.feature.auth.RegisterFragment"
        android:label="@string/title_register" />

    <!-- MAIN (có bottom nav) -->
    <fragment
        android:id="@id/homeFragment"
        android:name="com.example.ecom.feature.home.HomeFragment"
        android:label="@string/tab_home" />

    <fragment
        android:id="@id/ordersFragment"
        android:name="com.example.ecom.feature.order.OrdersFragment"
        android:label="@string/tab_orders" />

    <fragment
        android:id="@id/profileFragment"
        android:name="com.example.ecom.feature.profile.ProfileFragment"
        android:label="@string/tab_profile" />

    <!-- DETAIL (có nút back) -->
    <fragment
        android:id="@id/productDetailFragment"
        android:name="com.example.ecom.feature.product.ProductDetailFragment"
        android:label="@string/title_product_detail">
        <argument
            android:name="productId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@id/orderDetailFragment"
        android:name="com.example.ecom.feature.order.OrderDetailFragment"
        android:label="@string/title_order_detail">
        <argument
            android:name="orderId"
            app:argType="integer" />
    </fragment>

</navigation>
